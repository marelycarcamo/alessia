# ============================================================
# Configuración de ALESSIA
# ============================================================
# Copia este archivo como .env en la raíz del proyecto y completa
# los valores necesarios.
#
#     cp .env.example .env
#
# El archivo .env no se versiona: contiene credenciales.
# ============================================================

# Proveedor de modelo de lenguaje utilizado por el pipeline.
# Valores admitidos: "openrouter", "nvidia".
DEFAULT_PROVIDER=openrouter


# ------------------------------------------------------------
# OpenRouter
# ------------------------------------------------------------

# Credencial requerida para generar respuestas con este proveedor.
# Se obtiene en https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Modelo utilizado para generar las respuestas.
# "openrouter/auto" delega la selección del modelo en OpenRouter.
OPENROUTER_MODEL=openrouter/auto

# Opcional. Endpoint alternativo del servicio (proxy o gateway propio).
# Si se deja vacío se utiliza el servicio oficial de OpenRouter.
OPENROUTER_API_BASE_URL=


# ------------------------------------------------------------
# NVIDIA (NIM)
# ------------------------------------------------------------

# Credencial requerida para generar respuestas con este proveedor.
# Se obtiene en https://build.nvidia.com
NVIDIA_API_KEY=

# NVIDIA expone una API compatible con OpenAI en esta URL base.
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1

# Modelo utilizado. Ojo: el catálogo público de NVIDIA lista modelos
# que luego responden 404 o no contestan según la cuenta. Verifica el
# modelo elegido con una llamada real antes de desplegar.
NVIDIA_MODEL=minimaxai/minimax-m3.1-flash


# ------------------------------------------------------------
# Modelos de recuperación
# ------------------------------------------------------------

# Modelo de embeddings. Debe estar entrenado en español: la
# documentación es administrativa y local, y un modelo solo-inglés
# deja los vectores mal ubicados aunque el texto se vea bien.
#
# Si se cambia este valor hay que reconstruir el índice:
#     python scripts/build_index.py --recreate
# Si no, la búsqueda compara vectores de dos modelos distintos y
# devuelve fragmentos sin relación, sin ningún error visible.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Modelo CrossEncoder que reordena los fragmentos recuperados.
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# Probabilidad mínima para que un fragmento se use como contexto.
# Por debajo, ALESSIA responde que no encontró información en vez de
# construir una respuesta sobre material que no la contiene.
# 0.5 equivale a un puntaje 0: es el borde de decisión del modelo.
RERANK_MIN_PROBABILITY=0.5


# ------------------------------------------------------------
# Parámetros comunes de generación
# ------------------------------------------------------------

# Temperatura de generación: valores bajos producen respuestas más
# apegadas a la documentación recuperada.
LLM_TEMPERATURE=0.2

# Presupuesto máximo de tokens de salida. Los modelos de razonamiento
# consumen tokens razonando antes de responder, y ese consumo varía
# entre llamadas: en ALESSIA se midió entre 985 y 1.753. Con 1024 la
# respuesta llega vacía; con 2048 una de cada tres se truncó a mitad
# de frase. 4096 cubre el peor caso observado.
LLM_MAX_TOKENS=4096

# Segundos de espera máximos por respuesta. Debe superar la latencia
# real observada (las respuestas válidas tardaron entre 92 y 113 s): un
# límite más bajo descarta respuestas que sí eran correctas.
LLM_TIMEOUT_SECONDS=180
